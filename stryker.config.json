{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/changelog.ts",
    "src/config.ts"
  ],
  "buildCommand": "npm run build",
  "reporters": [
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 80
  }
}
