{
  "name": "pi-splash-screen",
  "version": "0.1.0",
  "description": "A startup splash screen extension for the Pi coding harness.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutation": "stryker run",
    "knip": "knip"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "knip": "^6.32.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "6.15.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
